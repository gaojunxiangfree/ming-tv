<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/sm_safe_edge"
    android:paddingRight="@dimen/sm_safe_edge">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_selector"
            android:paddingLeft="24dp"
            android:paddingTop="8dp"
            android:paddingRight="24dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:text="返回"
            android:textSize="@dimen/sm_text_body"
            android:textColor="@color/sm_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:text="@string/nav_settings"
            android:textSize="@dimen/sm_text_title"
            android:textColor="@color/sm_text"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_api"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etApiUrl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box"
                    android:padding="12dp"
                    android:hint="@string/settings_api_hint"
                    android:textColorHint="@color/sm_text_dim"
                    android:textSize="@dimen/sm_text_body"
                    android:textColor="@color/sm_text"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btnLoadApi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:background="@drawable/bg_button_selector"
                    android:paddingLeft="24dp"
                    android:paddingTop="10dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="10dp"
                    android:focusable="true"
                    android:text="加载"
                    android:textSize="@dimen/sm_text_body"
                    android:textColor="@color/sm_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvApiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim" />

            <TextView
                android:id="@+id/tvPushUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_primary"
                android:text="启动配置服务中…" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold"
                android:text="接口源管理" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="已保存的接口源: 点击切换, 长按删除; ★ 为当前源" />

            <!-- 接口源: 单行横向排列(可左右滚动), 避免多个源把整屏占满 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:focusable="false"
                android:descendantFocusability="afterDescendants"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/apiSourcesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sm_live_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="播放器设置"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="选择播放内核 (Exo 为系统内置, IJK 支持硬解/软解切换)" />

            <LinearLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/ijkDecoderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sm_live_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="播放设置"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="渲染方式 / 弹幕开关 / 循环播放 / P2P加速" />

            <LinearLayout
                android:id="@+id/renderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/danmuToggleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/loopContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/p2pContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sm_live_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="数据设置"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="清空搜索记录 / 播放历史 / 收藏" />

            <LinearLayout
                android:id="@+id/dataContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sm_live_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="播放样式设置"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="弹幕默认样式 (音量下方设置调整的取值)" />

            <LinearLayout
                android:id="@+id/danmuStyleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="字幕样式 (字号/颜色)" />

            <LinearLayout
                android:id="@+id/subtitleStyleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="文字大小 (全局界面文字缩放)" />

            <LinearLayout
                android:id="@+id/textScaleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvTextScaleSample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="3"
                android:lineSpacingMultiplier="1.3"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text"
                android:text="预览: 标题 36sp · 正文 28sp · 小字 24sp\n选集/线路文字随此缩放, 字幕弹幕另有独立字号" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="播放列表布局 (选集平铺网格 / 垂直列表)" />

            <LinearLayout
                android:id="@+id/playlistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sm_live_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="开屏页设置"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim"
                android:text="情话开关 / 自定义情话 / 背景图 URL, 开屏页右上角可跳过" />

            <LinearLayout
                android:id="@+id/splashContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sm_live_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_about"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_signature"
                android:textSize="@dimen/sm_text_body"
                android:textColor="@color/sm_text_dim" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
