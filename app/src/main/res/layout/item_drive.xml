<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_live_channel"
    android:padding="14dp"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/tvIcon"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/sm_text_body"
        android:text="📁" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textSize="@dimen/sm_text_body"
        android:textColor="@color/sm_text" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="1"
        android:textSize="@dimen/sm_text_small"
        android:textColor="@color/sm_text_dim" />
</LinearLayout>