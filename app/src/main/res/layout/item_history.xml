<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_card"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="6dp"
    android:padding="8dp">

    <!-- 海报 -->
    <ImageView
        android:id="@+id/ivPoster"
        android:layout_width="140dp"
        android:layout_height="190dp"
        android:scaleType="centerCrop"
        android:background="@color/sm_surface_light" />

    <!-- 信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="@dimen/sm_text_body"
            android:textColor="@color/sm_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEpisode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="@dimen/sm_text_small"
            android:textColor="@color/sm_text_dim" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="@dimen/sm_text_small"
            android:textColor="@color/sm_primary" />

        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/pbProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textSize="@dimen/sm_text_small"
            android:textColor="@color/sm_text_dim" />
    </LinearLayout>

    <!-- 删除按钮 -->
    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="10dp"
        android:background="@drawable/bg_button_selector"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:clickable="true"
        android:text="删除"
        android:textSize="@dimen/sm_text_small"
        android:textColor="@color/sm_text" />
</LinearLayout>
