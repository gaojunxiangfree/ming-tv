<?xml version="1.0" encoding="utf-8"?>
<!-- 升级提示弹窗: 版本号 + 更新说明 + 下载进度 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sm_surface"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发现新版本"
        android:textColor="@color/sm_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="6dp"
        android:textColor="@color/sm_text_dim"
        android:textSize="20sp" />

    <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvUpdateProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/sm_text_dim"
        android:textSize="18sp" />
</LinearLayout>
