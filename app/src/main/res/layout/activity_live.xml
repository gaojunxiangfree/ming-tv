<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_selector"
        android:paddingLeft="24dp"
        android:paddingTop="8dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="返回"
        android:textSize="@dimen/sm_text_body"
        android:textColor="@color/sm_text" />

    <!-- 数字键选台提示: 输入频道号时短暂显示 -->
    <TextView
        android:id="@+id/tvNumberInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_badge"
        android:paddingLeft="30dp"
        android:paddingTop="10dp"
        android:paddingRight="30dp"
        android:paddingBottom="10dp"
        android:textSize="@dimen/sm_text_title"
        android:textColor="@color/sm_text"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 左侧底部: 当前频道 + EPG 正在播/下一节目 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@+id/channelPanel"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!-- 节目信息区: 仅此区域点击查看完整节目单,
             面板空白/EPG 时间线区域不再误触发 -->
        <LinearLayout
            android:id="@+id/programInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_primary" />

            <TextView
                android:id="@+id/tvNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim" />
        </LinearLayout>

        <!-- EPG 时间线: 横向展示今日节目, 当前节目高亮+打点, 左右浏览, OK 回看已播节目 -->
        <HorizontalScrollView
            android:id="@+id/epgTimelineScroll"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/epgTimeline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/opRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLookback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="6dp"
                android:text="回看"
                android:textSize="@dimen/sm_text_body"
                android:textColor="@color/sm_text" />

            <TextView
                android:id="@+id/btnMulti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="6dp"
                android:text="多屏"
                android:textSize="@dimen/sm_text_body"
                android:textColor="@color/sm_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- 多屏同看容器: 2x2 四路播放(默认隐藏) -->
    <LinearLayout
        android:id="@+id/multiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧频道面板: 分组 Tab + 频道列表 -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="40dp"
        android:layout_marginRight="30dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusable="false"
            android:clipToPadding="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/sm_live_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:descendantFocusability="afterDescendants"
            android:paddingBottom="20dp" />
    </LinearLayout>
</RelativeLayout>