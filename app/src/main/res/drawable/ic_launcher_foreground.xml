<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景: 电视机 + 播放键(控制在 108dp 画布的安全区内) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 自适应图标遮罩会裁掉边缘, 整体内缩保证天线与底座完整 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">

    <!-- 天线 -->
    <path
        android:pathData="M43,36 L33,23"
        android:strokeColor="#FFF2FFF7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M65,36 L75,23"
        android:strokeColor="#FFF2FFF7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- 机身(屏幕) -->
    <path
        android:pathData="M30,36 h48 a6,6 0 0 1 6,6 v28 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 v-28 a6,6 0 0 1 6,-6 z"
        android:fillColor="#FF06301C"
        android:strokeColor="#FFF2FFF7"
        android:strokeWidth="4.5" />

    <!-- 播放键 -->
    <path
        android:pathData="M48,47 L68,55 L48,63 z"
        android:fillColor="#FF4ADE80" />

    <!-- 底座 -->
    <path
        android:pathData="M54,76 L54,82"
        android:strokeColor="#FFF2FFF7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M42,84 L66,84"
        android:strokeColor="#FFF2FFF7"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    </group>
</vector>
