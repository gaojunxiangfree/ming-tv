<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SeanMing" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:colorPrimary">@color/sm_primary</item>
        <item name="android:colorPrimaryDark">@color/sm_bg</item>
        <item name="android:colorAccent">@color/sm_primary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/sm_bg</item>
        <item name="android:textColor">@color/sm_text</item>
        <item name="android:textColorPrimary">@color/sm_text</item>
        <item name="android:textColorSecondary">@color/sm_text_dim</item>
        <item name="android:editTextColor">@color/sm_text</item>
    </style>
</resources>
