<?xml version="1.0" encoding="utf-8"?>
<!-- 手机竖屏播放页: 视频区在上(占满可用高度), 选集面板作为底部抽屉位于视频下方.
     控件(返回/标题/控制条/进度)叠加在视频区上, 行为与横屏版一致(代码只做显隐切换).
     手机横屏全屏时(PlayActivity 允许旋转)布局树按新尺寸重排, 视频区仍占满、控制条叠底, 无需切换布局.
     id 与横屏版完全一致, 供 PlayActivity 代码引用, 不得遗漏. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 视频区: 权重占满除选集面板外的全部空间 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 全屏播放器容器 (Exo/IJK 内核各自填充渲染视图) -->
        <FrameLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true" />

        <!-- 弹幕层(不拦截触摸, 手势仍作用于播放器) -->
        <com.seanming.player.ui.play.DanmakuView
            android:id="@+id/danmakuView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:visibility="gone" />

        <!-- 返回 -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_selector"
            android:paddingLeft="18dp"
            android:paddingTop="8dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:text="返回"
            android:textSize="@dimen/sm_text_body"
            android:textColor="@color/sm_text" />

        <!-- 标题(顶部居中, 左右留空避免与返回/顶栏信息重叠) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginLeft="88dp"
            android:layout_marginRight="88dp"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/sm_text_title"
            android:textColor="@color/sm_text"
            android:textStyle="bold" />

        <!-- 顶栏信息(右上角): 分辨率 | 网速 | 当前时间 -->
        <TextView
            android:id="@+id/tvTopInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:textSize="@dimen/sm_text_small"
            android:textColor="@color/sm_text_dim" />

        <!-- 手机全屏触发: 右下角小按钮, 点击切横屏(对齐爱奇艺/腾讯视频的操作习惯);
             横屏时同一布局继续使用(播放页声明了 configChanges 不会重建), 图标变为"退出全屏" -->
        <ImageView
            android:id="@+id/btnFullscreen"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="176dp"
            android:background="@drawable/bg_badge"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="全屏"
            android:padding="7dp"
            android:src="@drawable/ic_fullscreen" />

        <!-- 底部控制条: 两行, 均外包 HorizontalScrollView 防水平溢出(竖屏窄屏可横向滑动).
             第1行 主操作: 快进跳转/上一集/播放暂停/下一集/刷新/重播/循环;
             第2行 功能: 倍速/清晰度/字幕/弹幕/P2P/选集/内核/解码/渲染/片头/片尾/默认/音轨. -->
        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 第1行: 主操作 -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSeek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="⏩ 快进"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnPrev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="上一集"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="18dp"
                        android:paddingTop="6dp"
                        android:paddingRight="18dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="⏸ 暂停"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="下一集"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="刷新"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnReplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="重播"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnLoop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="循环 关"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text_dim" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 第2行: 功能 -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="倍速 1.0x"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_primary" />

                    <TextView
                        android:id="@+id/btnQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:visibility="gone"
                        android:text="清晰度"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="字幕"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnDanmaku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="弹幕"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnP2P"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="P2P 加速"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text_dim" />

                    <TextView
                        android:id="@+id/btnEpisodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="选集"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnKernel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="内核 Exo"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_primary" />

                    <TextView
                        android:id="@+id/btnDecoder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="解码 硬解"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnRender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="渲染 T"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnIntro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="片头 跳过"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnOutro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="片尾 跳过"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="默认"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />

                    <TextView
                        android:id="@+id/btnAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_selector"
                        android:paddingLeft="14dp"
                        android:paddingTop="6dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="6dp"
                        android:focusable="true"
                        android:text="音轨"
                        android:textSize="@dimen/sm_text_body"
                        android:textColor="@color/sm_text" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 播放进度条(可拖动, 位于控制条上方) -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="140dp"
            android:max="1000"
            android:progressTint="@color/sm_primary"
            android:thumbTint="@color/sm_primary"
            android:progressBackgroundTint="@color/sm_surface_light" />

        <!-- 进度时间 + 当前分辨率(底部左侧, 进度条上方) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="160dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim" />

            <TextView
                android:id="@+id/tvQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 手势指示(亮度/音量/进度), 中央浮动, 手势时显示 -->
        <TextView
            android:id="@+id/tvGesture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/sm_surface"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="12dp"
            android:textSize="@dimen/sm_text_body"
            android:textColor="@color/sm_text"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 选集面板(底部抽屉): 位于视频区下方, 展开时视频区按面板高度收缩.
         置于代码可见性控制: 展开时收起控制条/进度, 收起时恢复. -->
    <LinearLayout
        android:id="@+id/episodePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvEpisodeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选集"
                android:textSize="@dimen/sm_text_body"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按返回键收起"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim" />
        </LinearLayout>

        <!-- 页码范围收纳行(如 1-30 / 31-60), 仅剧集超过一页时显示 -->
        <HorizontalScrollView
            android:id="@+id/episodeRangeScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:focusable="false"
            android:descendantFocusability="afterDescendants"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/episodeRangeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="8dp"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 平铺网格: 固定三行高度(每格 60dp+4dp 边距), 列数由 ScreenUtil 按屏宽自适应 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="match_parent"
            android:layout_height="204dp"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
