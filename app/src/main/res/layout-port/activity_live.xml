<?xml version="1.0" encoding="utf-8"?>
<!-- 手机竖屏直播页: 视频全屏铺底, 选台面板(频道分组+列表)作为底部抽屉叠加在视频下方,
     频道节目信息区(台名/正在播/即将播/EPG时间线/回看/多屏)位于频道列表上方.
     channelPanel 与 infoPanel 由代码一起淡入淡出(INVISIBLE 保留空间), 因此保持叠加式布局;
     面板收起时视频全屏. id 与横屏版完全一致, 供 LiveActivity 代码引用, 不得遗漏. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_selector"
        android:paddingLeft="18dp"
        android:paddingTop="8dp"
        android:paddingRight="18dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="返回"
        android:textSize="@dimen/sm_text_body"
        android:textColor="@color/sm_text" />

    <!-- 数字键选台提示: 输入频道号时短暂显示 -->
    <TextView
        android:id="@+id/tvNumberInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_badge"
        android:paddingLeft="24dp"
        android:paddingTop="8dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp"
        android:textSize="@dimen/sm_text_title"
        android:textColor="@color/sm_text"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 频道节目信息区: 位于频道列表上方, 仅此区域点击查看完整节目单 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/channelPanel"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/programInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sm_text_title"
                android:textColor="@color/sm_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_primary" />

            <TextView
                android:id="@+id/tvNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="@dimen/sm_text_small"
                android:textColor="@color/sm_text_dim" />
        </LinearLayout>

        <!-- EPG 时间线: 横向展示今日节目, 当前节目高亮+打点, 左右浏览, OK 回看已播节目 -->
        <HorizontalScrollView
            android:id="@+id/epgTimelineScroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/epgTimeline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/opRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLookback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="回看"
                android:textSize="@dimen/sm_text_body"
                android:textColor="@color/sm_text" />

            <TextView
                android:id="@+id/btnMulti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingLeft="18dp"
                android:paddingTop="6dp"
                android:paddingRight="18dp"
                android:paddingBottom="6dp"
                android:text="多屏"
                android:textSize="@dimen/sm_text_body"
                android:textColor="@color/sm_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部频道面板: 分组 Tab + 频道列表 -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusable="false"
            android:clipToPadding="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/sm_live_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:descendantFocusability="afterDescendants"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- 多屏同看容器: 2x2 四路播放(默认隐藏) -->
    <LinearLayout
        android:id="@+id/multiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/mv4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
