<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 在线升级: 下载完成后调用系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- GSYVideoPlayer so 库要求 minSdk 23, 项目 minSdk 21, 强制 override -->
    <uses-sdk tools:overrideLibrary="com.shuyu.gsyvideoplayer.armv7a,com.shuyu.gsyvideoplayer.armv64,com.shuyu.gsyvideoplayer.x86_64" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/ic_logo"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.SeanMing">

        <!-- 在线升级: 把 cache/apk 下的安装包以 content:// 形式交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.HomeActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />

        <activity android:name=".ui.detail.DetailActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.history.HistoryActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.collect.CollectActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.search.SearchActivity" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.play.PlayActivity" android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.live.LiveActivity" android:screenOrientation="landscape"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.settings.SettingsActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.drive.DriveActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.push.PushActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />
        <activity android:name=".ui.search.FastSearchActivity" android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />

        <!-- 外部搜索广播入口(影视仓兼容): action = android.content.movie.search.Action -->
        <receiver
            android:name=".ui.search.SearchReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.movie.search.Action" />
            </intent-filter>
        </receiver>

        <!-- 自定义Web广播入口(影视仓兼容): action = android.content.movie.custom.web.Action, extra "url" -->
        <receiver
            android:name=".ui.web.CustomWebReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.movie.custom.web.Action" />
            </intent-filter>
        </receiver>

        <activity android:name=".ui.web.WebViewActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|orientation" />

        <!-- DLNA 投屏接收服务 (MediaRender/DMR): SSDP 发现 + HTTP 控制端 -->
        <service
            android:name=".service.DlnaService"
            android:exported="false" />
    </application>
</manifest>
